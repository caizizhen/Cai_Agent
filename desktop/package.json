{
  "name": "cai-desktop",
  "productName": "CAI Agent",
  "version": "1.2.0",
  "description": "CAI — Pi engine + DeepSeek Harness–inspired desktop shell",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.cai.agent",
    "productName": "CAI Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "CAI-Agent-Setup-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
